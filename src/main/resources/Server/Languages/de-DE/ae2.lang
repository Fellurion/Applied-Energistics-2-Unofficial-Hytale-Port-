items.AE2_Wireless_Access_Point.description = Gewährt drahtlosen Konsolen im Umkreis von 16 Blöcken Zugriff auf das Netzwerk; Drahtlosverstärker in seinem Platz erhöhen die Reichweite. Mit einer drahtlosen Konsole rechtsklicken, um sie zu verknüpfen.
items.AE2_Wireless_Booster.name = Drahtlosverstärker
items.AE2_Wireless_Booster.description = Erhöht die Reichweite eines drahtlosen ME-Zugangspunkts.
items.AE2_Wireless_Crafting_Terminal.name = Drahtlose Fertigungskonsole
items.AE2_Wireless_Crafting_Terminal.description = Eine drahtlose Konsole, die auch aus dem Netzwerk herstellen kann. Rechtsklick auf einen drahtlosen ME-Zugangspunkt verknüpft sie. Aufladen im Ladegerät.
items.AE2_Wireless_Receiver.name = Drahtlosempfänger
items.AE2_Wireless_Receiver.description = Empfängt Signale von drahtlosen ME-Zugangspunkten.
items.AE2_Wireless_Terminal.name = Drahtlose Zugangskonsole
items.AE2_Wireless_Terminal.description = Drahtloser Zugriff auf das ME-Netzwerk in Reichweite eines Zugangspunkts. Rechtsklick auf einen drahtlosen ME-Zugangspunkt verknüpft sie. Aufladen im Ladegerät.
items.AE2_Yellow_Covered_Cable.name = Gelb Verdecktes ME-Kabel
items.AE2_Yellow_Covered_Cable.description = Isoliertes ME-Kabel für bis zu 8 Kanäle. Verbindet sich nur mit Kabeln in Gelb oder Fluix.
items.AE2_Yellow_Covered_Dense_Cable.name = Gelbes dickes ME-Kabel
items.AE2_Yellow_Covered_Dense_Cable.description = Dichtes ME-Kabel für bis zu 32 Kanäle. Verbindet sich nur mit Kabeln in Gelb oder Fluix.
items.AE2_Yellow_Glass_Cable.name = Gelb ME-Glaskabel
items.AE2_Yellow_Glass_Cable.description = ME-Kabel für bis zu 8 Kanäle. Verbindet sich nur mit Kabeln in Gelb oder Fluix.
items.AE2_Yellow_Lumen_Paint_Ball.name = Gelb Lumen Farbball
items.AE2_Yellow_Lumen_Paint_Ball.description = Leuchtende Farbe (Gelb) für Farbapplikator und Materiekanone. In diesem Port färbt sie genau wie ein normaler Farbball – leuchtende Farbkleckse gibt es nicht.
items.AE2_Yellow_Paint_Ball.name = Gelb Farbball
items.AE2_Yellow_Paint_Ball.description = Farbe (Gelb) für den Farbapplikator und Munition für die Materiekanone.
items.AE2_Yellow_Smart_Cable.name = Gelb Schlaues ME-Kabel
items.AE2_Yellow_Smart_Cable.description = ME-Kabel, das seine Kanalbelegung anzeigt. Bis zu 8 Kanäle. Verbindet sich nur mit Kabeln in Gelb oder Fluix.
items.AE2_Yellow_Smart_Dense_Cable.name = Gelb Dichtes ME-Kabel
items.AE2_Yellow_Smart_Dense_Cable.description = Dichtes Smart-Kabel, das seine Kanalbelegung anzeigt. Bis zu 32 Kanäle. Verbindet sich nur mit Kabeln in Gelb oder Fluix.
items.AE2_Energistics_Workbench.name = Energistik-Werkbank
items.AE2_Energistics_Workbench.description = Eine Werkbank zur Herstellung von Applied-Energistics-2-Komponenten.

