items.AE2_View_Cell.name = Sichtzelle
items.AE2_View_Cell.description = In diesem Port noch ohne Funktion: Konsolen haben keine Plätze für Sichtzellen.
items.AE2_Void_Card.name = Overflow Zerstörungskarte
items.AE2_Void_Card.description = Upgrade: Vernichtet überzählige Items, statt sie abzulehnen.
