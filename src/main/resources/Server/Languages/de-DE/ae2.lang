items.AE2_Cell_Workbench.name = Speicherzellenwerkbank
items.AE2_Cell_Workbench.description = Stellt Partitionen und Upgrades von Speicherzellen ein. Baut auch Upgrade-Karten in drahtlose Konsolen, Materiekanone und Farbapplikator ein. Geduckt benutzen öffnet ihren Platz.
items.AE2_Certus_Quartz_Axe.name = Certusquarzaxt
items.AE2_Certus_Quartz_Axe.description = Eine Axt aus Certusquarz.
items.AE2_Certus_Quartz_Crystal.name = Certusquarzkristall
items.AE2_Certus_Quartz_Crystal.description = Ein Kristall mit ungewöhnlichen energiespeichernden Eigenschaften. Grundlage aller ME-Technik.
items.AE2_Certus_Quartz_Cutting_Knife.name = Certusquarzmeißel
items.AE2_Certus_Quartz_Cutting_Knife.description = Rechtsklick schneidet aus einem Metallbarren einen Schreiber-Namensdruck.
items.AE2_Certus_Quartz_Dust.name = Certusquarzstaub
items.AE2_Certus_Quartz_Dust.description = Gemahlener Certusquarz. Lässt sich zu Silizium schmelzen.
items.AE2_Certus_Quartz_Hoe.name = Certusquarzhacke
items.AE2_Certus_Quartz_Hoe.description = Eine Hacke aus Certusquarz.
items.AE2_Certus_Quartz_Pickaxe.name = Certusquarzspitzhacke
items.AE2_Certus_Quartz_Pickaxe.description = Eine Spitzhacke aus Certusquarz.
items.AE2_Certus_Quartz_Shovel.name = Certusquarzschaufel
