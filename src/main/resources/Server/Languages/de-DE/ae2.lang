items.AE2_Spatial_IO_Port.name = IO-Raumport
items.AE2_Spatial_IO_Port.description = Speichert den von Raumpylonen eingerahmten Bereich in einer Raumspeicherzelle oder holt ihn zurück. Zelle einlegen, dann den Port geduckt benutzen oder ihm ein Signal geben.
items.AE2_Spatial_Pylon.name = Raumpylon
items.AE2_Spatial_Pylon.description = Linien aus mindestens zwei Pylonen entlang der Kanten eines Quaders bauen; die Blöcke darin sind der Bereich. Linien dürfen einander nicht berühren.
items.AE2_Spatial_Storage_Cell_128.name = 128³-Raumspeicherzelle
items.AE2_Spatial_Storage_Cell_128.description = Speichert per Raum-IO einen Bereich von bis zu 128x128x128 Blöcken. Die erste Übertragung legt die Zelle auf diese Bereichsgröße fest.
items.AE2_Spatial_Storage_Cell_16.name = 16³-Raumspeicherzelle
items.AE2_Spatial_Storage_Cell_16.description = Speichert per Raum-IO einen Bereich von bis zu 16x16x16 Blöcken. Die erste Übertragung legt die Zelle auf diese Bereichsgröße fest.
items.AE2_Spatial_Storage_Cell_2.name = 2³-Raumspeicherzelle
items.AE2_Spatial_Storage_Cell_2.description = Speichert per Raum-IO einen Bereich von bis zu 2x2x2 Blöcken. Die erste Übertragung legt die Zelle auf diese Bereichsgröße fest.
items.AE2_Speed_Card.name = Beschleunigungskarte
