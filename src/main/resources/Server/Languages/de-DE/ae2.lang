items.AE2_Storage_Monitor.name = ME-Speichermonitor
items.AE2_Storage_Monitor.description = Zeigt die gespeicherte Menge eines einzelnen Items. Mit einem Item benutzen zeigt es an, mit leerer Hand löscht es; geduckt benutzen sperrt.
items.AE2_Terminal.name = ME-Konsole
items.AE2_Terminal.description = Zeigt und verwaltet alles, was im Netzwerk gespeichert ist.
items.AE2_Tiny_Tnt.name = Mini-TNT
items.AE2_Tiny_Tnt.description = Eine kleine Sprengladung. Benutzen, ein AE2-Signal oder Feuer zündet die Lunte.
items.AE2_Toggle_Bus.name = Schaltbarer ME-Bus
items.AE2_Toggle_Bus.description = Verbindet oder trennt Netzwerkteile per Signal. Benutzen schaltet den eingebauten Schalter um.
items.AE2_Vibration_Chamber.name = Vibrationskammer
