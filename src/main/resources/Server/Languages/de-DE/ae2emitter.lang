cmd.noConversionMonitor = [AE2] An dieser Position steht kein Konversionsmonitor.
cmd.noBus = [AE2] An dieser Position steht kein Import- oder Export-Bus.
cmd.noCardSlots = [AE2] Dieser Block nimmt keine Upgrade-Karten.
