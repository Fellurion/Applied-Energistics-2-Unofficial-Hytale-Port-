# Applied Energistics 2 – Füllstandsemitter, Quarzlichtsensor, Speicher- und Konversionsmonitor, Signal
# Datei ae2emitter.lang -> Schlüsselpräfix 'ae2emitter.'

# --- Einstellungsseite der Emitter
filter = Beobachtetes Item ({used}/{slots}) – leer: alle Items zählen
threshold.items = Schwelle: {value}
threshold.energy = Schwelle: {value} AE
setting.level.high_signal = Signal: ab der Schwelle
setting.level.low_signal = Signal: unter der Schwelle
setting.energy.high_signal = Signal: ab der Schwelle
setting.energy.low_signal = Signal: unter der Schwelle
setting.craft.no = Signal: solange das Item hergestellt wird
setting.craft.yes = Signal: um das Item herzustellen
info.level = {item}: {amount} von {threshold}
info.energy = Energie: {amount} von {threshold} AE
info.crafting = {item}: Crafting-Aufträge
watch.all = Alle Items
value.above = mehr als {threshold}
signal.on = Signal an
signal.off = Signal aus
note.item = Blöcke neben dem Emitter erhalten das Signal, zum Beispiel ein Bus mit Redstone-Karte. Eine Fuzzy-Karte zählt alle Varianten des Items, eine Crafting-Karte reagiert auf Crafting-Aufträge statt auf die Menge.
note.all = Ohne Item zählt der Emitter alles zusammen, was im Netz liegt.
note.energy = Vergleicht die im Netz gespeicherte Energie mit der Schwelle. Blöcke neben dem Emitter erhalten das Signal.
note.whileCrafting = Crafting-Karte: Das Signal ist an, solange eine Crafting-CPU auf dieses Item wartet (ohne Item: auf irgendetwas).
note.craftVia = Crafting-Karte: Das Item lässt sich zum Herstellen anfordern. Solange ein Auftrag darauf wartet, ist das Signal an – was es einschaltet, muss das Item ins Netz liefern.
hint.emitter = Klicke oben ein Item an, um es auszuwählen, dann den Itemplatz oder den Kartenplatz. Rechtsklick fügt es direkt hinzu. Klick auf einen belegten Platz leert ihn bzw. nimmt die Karte heraus.

# --- Busse mit Redstone-Karte
bus.signalOn = Redstone-Karte: Dieser Bus erhält ein Signal von einem Block daneben.
bus.signalOff = Redstone-Karte: kein Signal. Füllstandsemitter und Quarzlichtsensoren neben diesem Bus senden eines.

# --- Blickanzeige
hud.watching = Beobachtet
hud.amount = Menge
hud.amountOf = {amount} / {threshold}
hud.energy = Energie
hud.energyOf = {amount} / {threshold} AE
hud.mode = Signal wenn
hud.mode.above = ab der Schwelle
hud.mode.below = unter der Schwelle
hud.mode.whileCrafting = das Item hergestellt wird
hud.mode.craftVia = ein Auftrag das Item anfordert
hud.signal = Signal
hud.on = an
hud.off = aus
hud.item = Item
hud.noItem = keines
hud.craftable = herstellbar
hud.lock = Sperre
hud.locked = gesperrt
hud.unlocked = entsperrt
hud.light = Licht
hud.lightOf = {light} / {max}
hud.lightUnknown = noch nicht gemessen
hud.hint.storage = Benutzen: gehaltenes Item zeigen (leere Hand leert) · geduckt: sperren
hud.hint.storageLocked = Geduckt benutzen: entsperren
hud.hint.conversion = Benutzen: gehaltenes Item zeigen oder einlagern · geduckt: sperren
hud.hint.conversionLocked = Benutzen: gehaltenen Stapel einlagern · leere Hand: Stapel entnehmen
hud.hint.conversionSneak = Geduckt benutzen: alles einlagern (Item in der Hand) oder entsperren

# --- Monitore
monitor.offline = Der Monitor ist offline – kein Strom oder kein Kanal.
monitor.locked = Der Monitor ist jetzt gesperrt.
monitor.unlocked = Der Monitor ist jetzt entsperrt.
monitor.isLocked = Der Monitor ist gesperrt. Geduckt benutzen entsperrt ihn.
monitor.inserted = {amount}× {item} eingelagert.
monitor.insertFailed = {item} ließ sich nicht einlagern – kein Platz oder keine Energie im Netz.
monitor.extracted = {amount}× {item} entnommen.
monitor.extractFailed = Es ließ sich kein {item} aus dem Netz entnehmen.

