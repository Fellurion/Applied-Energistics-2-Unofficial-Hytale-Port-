cmd.installcard.desc = Baut eine Upgrade-Karte in ein Gerät ein
cmd.busmode.desc = Setzt den Signalmodus eines Import- oder Export-Bus
cmd.signal.desc = Zeigt, ob ein Block das AE2-Signal sendet oder erhält
cmd.light.desc = Zeigt die Helligkeit an einer Position
cmd.monitor.desc = Zeigt den Zustand eines Speicher- oder Konversionsmonitors
cmd.monitorset.desc = Setzt Item oder Sperre eines Monitors
cmd.monitorinsert.desc = Lagert Items über einen Konversionsmonitor ein
cmd.monitorextract.desc = Entnimmt das gezeigte Item über einen Konversionsmonitor
cmd.monitordisplay.desc = Schaltet die Anzeige der Monitore in der Welt ein oder aus
cmd.arg.setting = Einstellung
cmd.arg.value = Wert
cmd.arg.card = Item der Upgrade-Karte
cmd.arg.mode = Signalmodus
cmd.arg.onOff = on oder off
cmd.noEmitter = [AE2] An dieser Position steht kein Füllstandsemitter.
