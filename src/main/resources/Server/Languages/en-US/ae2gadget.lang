cmd.desc = Test commands for the powered tools and Tiny TNT
cmd.arg.what = tnt or cannon
cmd.arg.radius = Radius in blocks
cmd.arg.mode = heat or cool
cmd.arg.color = Colour, for example red, light_blue or fluix
cmd.arg.direction = east, west, up, down, south or north
cmd.ignite.desc = Ignite the Tiny TNT at a position
cmd.ignite.none = [AE2] No Tiny TNT at this position
cmd.ignite.done = [AE2] Tiny TNT ignited, fuse {ticks} ticks
cmd.ignite.already = [AE2] Tiny TNT is already burning, fuse {ticks} ticks
cmd.blockdamage.desc = Switch block damage of Tiny TNT or the Matter Cannon for this server run
cmd.blockdamage.set = [AE2] Block damage: Tiny TNT {tnt}, Matter Cannon {cannon}
cmd.drop.desc = Drop an item on the ground
cmd.drop.unknown = [AE2] Unknown item {item}
cmd.drop.done = [AE2] Dropped {amount} × {item}
cmd.items.desc = List the items lying on the ground around a position
cmd.items.list = [AE2] {count} items on the ground: {items}
cmd.charge.desc = Show the charge of the item in a block slot
cmd.charge.empty = [AE2] No item in this slot
cmd.charge.value = [AE2] {item}: {stored} / {max} AE
cmd.entropy.desc = Heat or cool a block like the Entropy Manipulator
