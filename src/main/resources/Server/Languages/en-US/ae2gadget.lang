cmd.entropy.result = [AE2] Entropy {outcome}: {before} -> {after} (above: {above})
cmd.recolor.desc = Recolour a cable like the Color Applicator
cmd.recolor.color = [AE2] Unknown colour
cmd.recolor.done = [AE2] Recoloured: {before} -> {after}
cmd.recolor.none = [AE2] Nothing recoloured: {before} -> {after}
cmd.shoot.desc = Fire a Matter Cannon shot from a position
cmd.shoot.direction = [AE2] Direction must be east, west, up, down, south or north
cmd.shoot.noAmmo = [AE2] {item} is no Matter Cannon ammunition
cmd.shoot.result = [AE2] Shot with penetration {penetration}: {destroyed} blocks destroyed
cmd.fill.desc = Fully charge the tool in your hand
cmd.fill.none = [AE2] The item in your hand has no battery
cmd.fill.done = [AE2] Charged to {stored} AE
cmd.arg.fluid = Fluid id, none to remove it, or get to only show the cell
cmd.fluid.desc = Set or remove the fluid of a cell
cmd.fluid.now = [AE2] Cell is now {cell}
cmd.signal.desc = Emit an AE2 signal at a position
