$C = "../../Common.ui";

// ME-Terminal (AE2) als eigene Seite (ohne FTCore): links der Inhalt des ME-Netzes, rechts das Inventar.
//
// Links-/Rechtsklick auf einen Eintrag entnimmt einen Stapel bzw. ein Item, Klick auf ein Inventarfeld lagert ein,
// Ziehen zwischen den Gittern lagert ein bzw. aus. Die Gitter hängen über InventorySectionId an Fenstern, die die
// Seite beim Öffnen anlegt (TerminalPage.open); ohne Fenster bleibt es bei den Klicks.
//
// Feldgröße 48 mit Abstand 2; ein Feld belegt damit 50 Punkte. Über dem Netz-Gitter liegen die Mengen im AE2-Stil
// (#AE2NetAmounts, eine Zeile je 9 Felder, TerminalAmountRow.ui); sie fangen keine Klicks ab.

@GridStyle = (
  SlotSize: 48,
  SlotIconSize: 40,
  SlotSpacing: 2,
  SlotBackground: "../../Common/BlockSelectorSlotBackground.png"
);

@StatusStyle = (FontSize: 14, TextColor: #7caacc, VerticalAlignment: Center);
@InfoStyle = (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center);
@HeaderStyle = (FontSize: 14, TextColor: #96a9be, RenderBold: true, VerticalAlignment: Center);
@EmptyStyle = (FontSize: 15, TextColor: #5a6a7a, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
@HintStyle = (FontSize: 12, TextColor: #5a6a7a, VerticalAlignment: Center, Wrap: true);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 980, Height: 690);

  #Title {
    Group {
      LayoutMode: Left;
      $C.@Title #AE2Title {
        @Text = "ME Terminal";
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // Linke Spalte: das ME-Netz
    Group #AE2NetColumn {
      Anchor: (Width: 456);
      LayoutMode: Top;

      // Status links, rechts daneben „Zugriff“ (nur für Besitzer/Admins sichtbar, TerminalView)
      Group {
        Anchor: (Height: 44);
        LayoutMode: Left;

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #AE2Status { Text: ""; Anchor: (Height: 24); Style: @StatusStyle; }
          Label #AE2Storage { Text: ""; Anchor: (Height: 20); Style: @InfoStyle; }
        }

        $C.@SmallSecondaryTextButton #AE2Access {
          @Anchor = (Width: 150, Top: 6);
          @Text = "";
          Visible: false;
        }
      }

      Group { Anchor: (Height: 6); }

      Group {
        Anchor: (Height: 44);
        LayoutMode: Left;

        $C.@TextField #AE2Search {
          FlexWeight: 1;
          PlaceholderText: %ae2ui.terminal.search;
        }

        Group { Anchor: (Width: 8); }

        $C.@SecondaryTextButton #AE2Sort {
          @Anchor = (Width: 170);
          Text: "";
        }
      }

      Group { Anchor: (Height: 6); }

      // Gitter und Mengen übereinander: die Gruppe hat kein LayoutMode
      Group #AE2NetStack {
        Anchor: (Width: 450, Height: 350);

        ItemGrid #AE2NetGrid {
          Anchor: (Left: 0, Top: 0, Width: 450, Height: 350);
          SlotsPerRow: 9;
          AreItemsDraggable: true;
          RenderEmptySlots: true;
          DisplayItemQuantity: false;
          Style: @GridStyle;
        }

        Group #AE2NetAmounts {
          Anchor: (Left: 0, Top: 0, Width: 450, Height: 350);
          LayoutMode: Top;
          HitTestVisible: false;
        }

        Label #AE2Empty {
          Text: "";
          Anchor: (Left: 20, Top: 145, Width: 410, Height: 60);
          Style: @EmptyStyle;
          Visible: false;
        }
      }

      Group { Anchor: (Height: 6); }

      Group {
        Anchor: (Height: 44);
        LayoutMode: Left;

        $C.@SecondaryTextButton #AE2Prev {
          @Anchor = (Width: 44);
          Text: "<";
        }

        Label #AE2PageLabel {
          Text: "1 / 1";
          Anchor: (Width: 80);
          Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        $C.@SecondaryTextButton #AE2Next {
          @Anchor = (Width: 44);
          Text: ">";
        }

        Group { FlexWeight: 1; }

        $C.@SecondaryTextButton #AE2CraftMode {
          @Anchor = (Width: 190);
          Text: "";
        }
      }

      Group { Anchor: (Height: 6); }

      Label #AE2Hint { Text: ""; Anchor: (Height: 40); Style: @HintStyle; }
    }

    Group { Anchor: (Width: 22); }

    // Rechte Spalte: das Inventar des Spielers. #BackpackGrid bleibt aus, solange der Spieler keinen Rucksack trägt.
    Group #AE2InvColumn {
      Anchor: (Width: 456);
      LayoutMode: Top;

      Label #AE2InvHeader { Text: ""; Anchor: (Height: 24); Style: @HeaderStyle; }

      ItemGrid #StorageGrid {
        Anchor: (Width: 450, Height: 200);
        SlotsPerRow: 9;
        AreItemsDraggable: true;
        RenderEmptySlots: true;
        DisplayItemQuantity: true;
        Style: @GridStyle;
      }

      Label #AE2HotbarHeader { Text: ""; Anchor: (Top: 6, Height: 20); Style: @HeaderStyle; }

      ItemGrid #HotbarGrid {
        Anchor: (Width: 450, Height: 50);
        SlotsPerRow: 9;
        AreItemsDraggable: true;
        RenderEmptySlots: true;
        DisplayItemQuantity: true;
        Style: @GridStyle;
      }

      Label #AE2BackpackHeader { Text: ""; Anchor: (Top: 6, Height: 20); Style: @HeaderStyle; }

      ItemGrid #BackpackGrid {
        Anchor: (Width: 450, Height: 200);
        SlotsPerRow: 9;
        AreItemsDraggable: true;
        RenderEmptySlots: true;
        DisplayItemQuantity: true;
        Style: @GridStyle;
      }

      Group { FlexWeight: 1; }

      Group {
        Anchor: (Height: 44);
        LayoutMode: Left;

        $C.@TextButton #AE2InsertAll {
          @Anchor = (Width: 230);
          Text: "";
        }

        Group { FlexWeight: 1; }

        $C.@SecondaryTextButton #AE2Cpus {
          @Anchor = (Width: 210);
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}
