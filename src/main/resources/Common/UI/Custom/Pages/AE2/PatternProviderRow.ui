$C = "../../Common.ui";

// Ein Pattern Provider im Pattern-Zugriffsterminal: Symbol, Name, Position, Online/Offline, „Einlegen“ und darunter
// seine 9 Pattern-Felder. Die Felder zeigen, was das Pattern herstellt (PatternAccessPage.java); Klick auf ein
// belegtes Feld nimmt das Pattern ins Inventar, Klick auf ein leeres Feld legt das gewählte Pattern ab.

@GridStyle = (
  SlotSize: 48,
  SlotIconSize: 40,
  SlotSpacing: 2,
  SlotBackground: "../../Common/BlockSelectorSlotBackground.png"
);

Group {
  Anchor: (Height: 102);
  Padding: (Vertical: 3);

  Group #Card {
    Anchor: (Full: 0);
    LayoutMode: Top;
    Background: #1c2835;
    Padding: (Horizontal: 8, Vertical: 4);

    Group {
      Anchor: (Height: 34);
      LayoutMode: Left;

      Group {
        Anchor: (Width: 34, Height: 34);
        Background: #1a2530;
        Padding: 1;

        ItemSlot #Icon {
          Anchor: (Full: 0);
          ShowQualityBackground: true;
          ShowQuantity: false;
        }
      }

      Label #Name {
        Text: "";
        FlexWeight: 1;
        Padding: (Left: 10);
        Style: (FontSize: 15, TextColor: #d3d6db, RenderBold: true, VerticalAlignment: Center);
      }

      Label #Info {
        Text: "";
        Anchor: (Width: 150);
        Style: (FontSize: 13, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
      }

      // Zustand: Online (#Online) oder Offline (#Offline), nie beide
      Group {
        Anchor: (Width: 76);

        Label #Online {
          Text: "";
          Anchor: (Full: 0);
          Style: (FontSize: 13, TextColor: #9ec47a, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
        }

        Label #Offline {
          Text: "";
          Anchor: (Full: 0);
          Style: (FontSize: 13, TextColor: #e0796b, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
          Visible: false;
        }
      }

      Group { Anchor: (Width: 10); }

      $C.@SmallSecondaryTextButton #Insert {
        @Anchor = (Width: 170, Top: 1);
        @Text = "";
      }
    }

    Group { Anchor: (Height: 4); }

    ItemGrid #Patterns {
      Anchor: (Width: 450, Height: 50);
      SlotsPerRow: 9;
      AreItemsDraggable: true;
      RenderEmptySlots: true;
      DisplayItemQuantity: true;
      Style: @GridStyle;
    }
  }
}
