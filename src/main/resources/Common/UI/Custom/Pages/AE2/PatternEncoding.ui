$C = "../../Common.ui";

// Pattern-Kodierterminal (AE2): Hytale-Rezept wählen und als Pattern kodieren.
$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1000, Height: 660);

  #Title {
    Group {
      LayoutMode: Left;
      $C.@Title #PageTitle {
        @Text = "Pattern Encoding Terminal";
      }
    }

    $C.@HeaderSearch {}
  }

  #Content {
    LayoutMode: Left;
    Padding: (Horizontal: 10, Vertical: 8);

    // Links: Suchergebnisse (Items mit Rezept)
    Group #LeftCol {
      Anchor: (Width: 340);
      LayoutMode: Top;

      Label #ResultsHeader {
        Anchor: (Height: 26);
        Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
        Text: "";
      }

      Group #ResultsContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Background: #141d26;
        Padding: 4;

        Group #Results {
          LayoutMode: LeftCenterWrap;
        }
      }

      Group {
        Anchor: (Height: 50);
        LayoutMode: Left;
        Padding: (Top: 8);

        $C.@TextButton #UseHeld {
          Text: "Use held item";
          FlexWeight: 1;
        }
      }
    }

    Group {
      Anchor: (Width: 12);
    }

    // Rechts: gewähltes Item und seine Rezepte
    Group #RightCol {
      FlexWeight: 1;
      LayoutMode: Top;

      Group #TargetRow {
        Anchor: (Height: 74);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 64, Height: 64);
          Background: #1a2530;
          Padding: 2;

          ItemSlot #TargetIcon {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            ShowQuantity: false;
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 6);

          Label #TargetName {
            Anchor: (Height: 26);
            Style: (FontSize: 18, TextColor: #d3d6db, RenderBold: true, VerticalAlignment: Center);
            Text: "";
          }

          Label #BlankInfo {
            Anchor: (Height: 22);
            Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
            Text: "";
          }
        }
      }

      Group {
        Anchor: (Height: 2);
        Background: #19252F;
      }

      Group #RecipesContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Top: 6);

        Group #Recipes {
          LayoutMode: Top;
        }
      }

      Label #Status {
        Anchor: (Height: 28);
        Style: (FontSize: 14, TextColor: #7caacc, VerticalAlignment: Center);
        Text: "";
      }
    }
  }
}

$C.@BackButton {}
