        Padding: 6;

        ItemSlot #Icon2 {
          Anchor: (Full: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }
      }
    }

    Label #Caption2 {
      Anchor: (Height: 34);
      Style: $B.@CaptionStyle;
      Text: "";
    }
  }
  Group #Cell3 {
    Anchor: (Width: 80);
    LayoutMode: Top;
    Visible: false;

    Group {
      Anchor: (Height: 70);
      Padding: (Horizontal: 6, Top: 2, Bottom: 2);

      Group {
        Anchor: (Full: 0);
        Background: $B.@FrameBackground;
        Padding: 6;

        ItemSlot #Icon3 {
          Anchor: (Full: 0);
