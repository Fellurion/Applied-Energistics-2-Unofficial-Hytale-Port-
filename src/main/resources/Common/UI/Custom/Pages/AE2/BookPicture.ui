        }
      }
    }

    Label #Caption3 {
      Anchor: (Height: 34);
      Style: $B.@CaptionStyle;
      Text: "";
    }
  }
  Group #Cell4 {
    Anchor: (Width: 80);
    LayoutMode: Top;
    Visible: false;

    Group {
      Anchor: (Height: 70);
      Padding: (Horizontal: 6, Top: 2, Bottom: 2);

      Group {
        Anchor: (Full: 0);
        Background: $B.@FrameBackground;
        Padding: 6;

        ItemSlot #Icon4 {
          Anchor: (Full: 0);
          ShowQualityBackground: false;
          ShowQuantity: false;
        }
      }
    }

    Label #Caption4 {
      Anchor: (Height: 34);
      Style: $B.@CaptionStyle;
      Text: "";
    }
  }
}
